{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "e2e-inc/e2e"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "fixed": [
    [
      "e2e",
      "@e2e-dev/core"
    ],
    [
      "@e2e-dev/desktop",
      "@e2e-dev/desktop-darwin-arm64",
      "@e2e-dev/desktop-darwin-x64"
    ],
    [
      "@e2e-dev/util",
      "@e2e-dev/util-darwin-arm64",
      "@e2e-dev/util-darwin-x64",
      "@e2e-dev/util-linux-arm64-gnu",
      "@e2e-dev/util-linux-arm64-musl",
      "@e2e-dev/util-linux-x64-gnu",
      "@e2e-dev/util-linux-x64-musl",
      "@e2e-dev/util-win32-arm64-msvc",
      "@e2e-dev/util-win32-x64-msvc"
    ]
  ],
  "linked": [],
  "ignore": [],
  "privatePackages": false,
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}-{datetime}"
  },
  "___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
    "onlyUpdatePeerDependentsWhenOutOfRange": true
  }
}
